# Credential profile template. The installer copies this to the resolved file
# under ~/.config/ghl/profiles/ (or $GHL_CONFIG_DIR/profiles/), not repo .env.

# --- Required: GoHighLevel public API ---
# Create a Private Integration Token in GHL:
#   Settings -> Private Integrations -> Create New
# Give it every scope you want the CLI to use (contacts, workflows, etc).
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your GHL location/sub-account ID (the long string in your GHL URL).
GHL_LOCATION_ID=YOUR_LOCATION_ID

# Optional agency/company-scoped token for the read-only `ghl saas` commands.
# Keep the location token above in place. SaaS requests use this token when set,
# while every existing location command continues to use GHL_API_KEY.
GHL_AGENCY_API_KEY=

# Optional settings for `ghl saas audit` and the lifecycle commands.
# GHL_SAAS_PRODUCT_ID: the payment product your SaaS plan is sold under.
# GHL_INTERNAL_DOMAINS: comma-separated email domains to count as your own team.
# GHL_SAAS_BASELINE: expected subscriptions/contacts, e.g. 280/250. Unset = no check.
# GHL_PROTECTED_LOCATION_ID: location lifecycle commands must never touch.
#   Defaults to GHL_LOCATION_ID.
GHL_SAAS_PRODUCT_ID=
GHL_INTERNAL_DOMAINS=
GHL_SAAS_BASELINE=
GHL_PROTECTED_LOCATION_ID=

# --- Optional: white-label domain ---
# Only affects the links the CLI hands back to you after it builds something.
# Leave it unset unless your agency serves GHL from its own domain; the default
# is the one you log into.
GHL_APP_DOMAIN=app.gohighlevel.com

# --- Optional / advanced: Firebase token for the UNOFFICIAL "internal API" ---
# The public GHL API can't *create* workflows, only read them. To create/update
# workflows programmatically the CLI uses GHL's unofficial internal API, which
# needs a Firebase refresh token.
#
# Most people don't need this: to provision workflows, build one in the GHL UI
# and ship it in a Snapshot (sub-accounts inherit it) — no token required. See
# the "Workflow building" section of README.md.
#
# !! THE FIREBASE REFRESH TOKEN IS YOUR ENTIRE GHL LOGIN (full account access),
#    NOT a scoped key. Use it on YOUR OWN agency account only — never a client's,
#    and never against client sub-accounts. Treat it like a password: prefer a
#    secret manager / OS keychain over leaving it at rest in a profile. Never
#    commit a populated copy.
#
# Get one with the DevTools console snippet in docs/get-firebase-token.md:
#   1. Open app.gohighlevel.com (logged in), open DevTools console
#   2. Paste the snippet -> it copies your refresh token to the clipboard
#   3. Paste here:
GHL_FIREBASE_REFRESH_TOKEN=

# The Firebase web key from the same session. The snippet in
# docs/get-firebase-token.md prints this alongside the refresh token. Both are
# read from your own logged-in browser; nothing is vendored in this package.
# Unlike the refresh token above this one is not a login credential, but it is
# still read from your session rather than shipped, so set it before using any
# --experimental command.
GHL_FIREBASE_API_KEY=

# OPTIONAL, and normally left empty. The proposal service authenticates on the
# Firebase token-id alone; this was measured on 2026-08-24, having previously
# been assumed mandatory. Only set it if you have a specific reason to send the
# template builder's bearer, and unset it again if a contract command 401s --
# the service tries to resolve a bearer whenever it gets one, so a stale value
# here fails where an empty one succeeds. Never commit it.
GHL_IAM_TOKEN=

# Optional IANA timezone override for fresh contract-template shells. When
# unset, contract authoring uses the CLI machine's local timezone.
GHL_CONTRACT_TIMEZONE=
