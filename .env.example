# ===== Growth Factor Dashboard — environment =====
# Copy to .env (gitignored). This dashboard gives shell access to the server,
# so it will NOT start without a login (DASHBOARD_USERS or DASHBOARD_PASSWORD).

# --- auth (set ONE of these) ---
# Named logins, comma-separated "user:password" pairs (preferred). Store HASHES, not
# plaintext: run `node server/hash-password.js 'the password'` and paste the scrypt$... value.
#   DASHBOARD_USERS="ben:scrypt$...,lorenz:scrypt$..."
DASHBOARD_USERS=ben:ChangeMe,lorenz:ChangeMe
# ...or a single shared password (username optional at the login screen):
DASHBOARD_PASSWORD=
# set to 1 behind TLS (Caddy) so the session cookie is Secure + HSTS is sent:
COOKIE_SECURE=1
# session lifetime (optional): idle timeout and absolute cap, in ms
# SESSION_IDLE_MS=28800000     # 8h inactivity
# SESSION_MAX_MS=604800000     # 7d hard cap

# --- two-factor: emailed one-time code (enforced only when BOTH are set) ---
# Who gets the code, per username:
DASHBOARD_USER_EMAILS=ben:ben@growth-factor.ai,lorenz:lorenz@growth-factor.ai
MAIL_FROM=Growth Factor <noreply@growth-factor.ai>
# ...and ONE mail backend:
# RESEND_API_KEY=            # easiest: a Resend API key (https://resend.com), no extra setup
# SMTP_URL=smtps://user:pass@smtp.host:465     # or any SMTP mailbox (e.g. Google Workspace)
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  SMTP_SECURE=0   # (alternative to SMTP_URL)
# TWOFA_DEV_ECHO=1          # LOCAL TESTING ONLY: prints the code to the server log instead of emailing

# --- Claude in the terminals ---
# Account/login the spawned `claude` uses (the "gf alias" config dir):
CLAUDE_CONFIG_DIR=/home/gf/.config/claude-gf
# Default model for Claude panes + skills (needs a recent Claude Code):
DASHBOARD_CLAUDE_MODEL=claude-opus-5-5

# --- paths / limits (usually fine as defaults) ---
# WORKDIR=/workspace        # folder terminals start in (default: the user's home)
# SKILLS_DIR=./skills
# UPLOAD_DIR=./uploads
# CLAUDE_CMD=claude
MAX_PANES=12
# AUTH_DISABLED=1           # LOCAL TESTING ONLY: skips login, binds 127.0.0.1

# --- metrics (read-only GHL) ---
# Real location IDs live in metrics.config.json (gitignored). Tokens go here,
# one per business, named by that business's tokenEnv. Location-level PITs:
GHL_DEMO_TOKEN=
GHL_FPMMA_TOKEN=
GHL_FIGHTERS_TOKEN=
GHL_NMMA_TOKEN=
# GHL_NMMATC_TOKEN=        # Nashville MMA memberships sub-account (if added)
# METRICS_CONFIG=./metrics.config.json
# METRICS_HISTORY=./metrics-history.json   # daily snapshots for sparklines (our own file)

# --- optional integrations (Phase 2 live widgets; launcher works without them) ---
# N8N_API_KEY=             # hosted n8n REST API, to show live flow status
# OPENSEO_TOKEN=           # OpenSEO server token, to show live SEO widgets

# --- voice dictation in the terminals (Wispr Flow) ---
# When set, each pane shows a mic button: speak, and the transcript is inserted at
# the prompt. The key stays server-side (never sent to the browser or a terminal).
# Access is exclusive/enterprise — see https://api-docs.wisprflow.ai/
# WISPR_API_KEY=
# WISPR_API_URL=           # optional; defaults to the Wispr REST endpoint

# --- Supabase (central lead data + agent logging; see supabase/schema.sql) ---
# Server-side ONLY. Service role bypasses RLS — never expose to the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
