# ===== Growth Factor Dashboard — environment =====
# Copy to .env (gitignored). This dashboard gives shell access to the server,
# so it will NOT start without a login (DASHBOARD_USERS or DASHBOARD_PASSWORD).

# --- auth (set ONE of these) ---
# Named logins, comma-separated "user:password" pairs (preferred):
DASHBOARD_USERS=ben:ChangeMe,lorenz:ChangeMe
# ...or a single shared password (username optional at the login screen):
DASHBOARD_PASSWORD=
# REQUIRED. 64 hex chars:  openssl rand -hex 32   (signs login cookies)
SESSION_SECRET=
# set to 1 behind TLS (nginx/Caddy) so the session cookie is Secure:
COOKIE_SECURE=1

# --- Claude in the terminals ---
# Account/login the spawned `claude` uses (the "gf alias" config dir):
CLAUDE_CONFIG_DIR=/home/gf/.config/claude-gf
# Default model for Claude panes + skills (needs a recent Claude Code):
DASHBOARD_CLAUDE_MODEL=claude-opus-5-5

# --- paths / limits (usually fine as defaults) ---
# WORKDIR=/workspace        # folder terminals start in (default: the user's home)
# SKILLS_DIR=./skills
# UPLOAD_DIR=./uploads
# CLAUDE_CMD=claude
MAX_PANES=12
# AUTH_DISABLED=1           # LOCAL TESTING ONLY: skips login, binds 127.0.0.1

# --- metrics (read-only GHL) ---
# Real location IDs live in metrics.config.json (gitignored). Tokens go here,
# one per business, named by that business's tokenEnv. Location-level PITs:
GHL_DEMO_TOKEN=
GHL_FPMMA_TOKEN=
GHL_FIGHTERS_TOKEN=
GHL_NMMA_TOKEN=
# GHL_NMMATC_TOKEN=        # Nashville MMA memberships sub-account (if added)
# METRICS_CONFIG=./metrics.config.json
# METRICS_HISTORY=./metrics-history.json   # daily snapshots for sparklines (our own file)

# --- optional integrations (Phase 2 live widgets; launcher works without them) ---
# N8N_API_KEY=             # hosted n8n REST API, to show live flow status
# OPENSEO_TOKEN=           # OpenSEO server token, to show live SEO widgets

# --- Supabase (central lead data + agent logging; see supabase/schema.sql) ---
# Server-side ONLY. Service role bypasses RLS — never expose to the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
